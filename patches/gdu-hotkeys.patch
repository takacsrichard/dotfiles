 		if ui.pages.HasPage("help") {
@@ -317,6 +332,9 @@ func (ui *UI) handleMainActions(key *tcell.EventKey) *tcell.EventKey {
 		return nil
 	case 'I':
 		ui.ignoreItem()
+	case 'Y':
+		ui.yankPending = true
+		return nil
 	}
 	return key
 }
