 		return nil
 	}
 
+	if ui.yankPending {
+		return ui.handleYankChord(key)
+	}
+
 	return ui.handleMainActions(key)
 }
 
+func (ui *UI) handleYankChord(key *tcell.EventKey) *tcell.EventKey {
+	ui.yankPending = false
+	switch key.Rune() {
+	case 'c':
+		ui.copySelectedFullPath()
+	case 'd':
+		ui.copySelectedDirPath()
+	}
+	return nil
+}
