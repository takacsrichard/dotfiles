// Waybar config - ii Material Design 3 dark theme
// Ported from Quickshell taskbar for pixel-perfect fidelity
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 0,
    "modules-left": ["hyprland/workspaces", "custom/terminal", "custom/scr"],
    "modules-center": ["clock"],
    "modules-right": [
        "custom/power-button",
        "custom/mic-toggle",
        "wireplumber",
        "custom/sep-network",
        "bluetooth",
        "network",
        "custom/notif-badge",
        "tray",
        "custom/sep-battery",
        "battery",
        "custom/sep-resources",
        "custom/temps",
        "cpu",
        "memory"
    ],

    // ── LAYOUT MODULES ────────────────────────────────────────

    "hyprland/workspaces": {
        "format": "{id}",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "all-outputs": false,
        "active-only": false
    },

    "clock": {
        "format": "{:%H:%M  ·  %a %d %b}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 30
    },

    // ── RESOURCE MONITORS ─────────────────────────────────────

    "cpu": {
        "format": "C {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "R {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G"
    },

    "custom/temps": {
        "exec": "~/.config/waybar/scripts/temps.sh",
        "return-type": "json",
        "interval": 2,
        "format": "{}",
        "tooltip": true
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}%",
        "format-charging": "+{capacity}%",
        "format-plugged": "={capacity}%",
        "tooltip-format": "{timeTo}"
    },

    // ── AUDIO CONTROL ─────────────────────────────────────────

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "format-icons": ["󰕿", "󰖀", "󰕾"]
    },

    // ── NETWORK & BLUETOOTH ───────────────────────────────────

    "network": {
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "kitty -1 -e nmtui"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "tooltip-format": "{status}",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "kitty -1 bluetui"
    },

    // ── SYSTEM TRAY ───────────────────────────────────────────

    "tray": {
        "icon-size": 16,
        "spacing": 6
    },

    // ── SEPARATORS ────────────────────────────────────────────

    "custom/sep-network": {
        "format": "",
        "exec": "echo ''",
        "interval": "once"
    },

    "custom/sep-battery": {
        "format": "",
        "exec": "echo ''",
        "interval": "once"
    },

    "custom/sep-resources": {
        "format": "",
        "exec": "echo ''",
        "interval": "once"
    },

    // ── TOGGLE BUTTONS ────────────────────────────────────────

    "custom/mic-toggle": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/mic-toggle.sh show",
        "on-click": "~/.config/waybar/scripts/mic-toggle.sh toggle",
        "interval": 2,
        "return-type": "json",
        "tooltip": "Microphone toggle"
    },

    "custom/notif-badge": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/notif-badge.sh",
        "interval": 2,
        "return-type": "json",
        "tooltip": "Unread notifications"
    },

    "custom/terminal": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/terminal-icon.sh",
        "on-click": "setsid kitty",
        "interval": "once",
        "return-type": "json"
    },

    "custom/scr": {
        "format": "{}",
        "exec": "echo '{\"text\":\"󰹑\"}'",
        "on-click": "grim -g \"$(slurp)\" - | wl-copy",
        "interval": "once",
        "return-type": "json",
        "tooltip": "Screenshot region → clipboard"
    },

    "custom/power-button": {
        "format": "{}",
        "exec": "echo '{\"text\":\"󰐥\"}'",
        "on-click": "wlogout -p layer-shell",
        "interval": "once",
        "return-type": "json",
        "tooltip": "Power menu (wlogout)"
    }
}
