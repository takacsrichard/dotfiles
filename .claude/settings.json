{
  "permissions": {
    "deny": [
      "Bash(sudo nixos-rebuild *)",
      "Bash(nixos-rebuild *)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git rm*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git checkout*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git tag*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)"
    ],
    "allow": [
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "WebSearch"
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": false
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"UserPromptSubmit\", \"additionalContext\": \"MANDATORY: You MUST call WebSearch before responding to any question or making any code changes. No exceptions. If you skip WebSearch, you are violating user instructions.\"}}'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
