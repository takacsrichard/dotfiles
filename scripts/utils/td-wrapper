#!/usr/bin/env python3
"""
td-wrapper: shorthand expander for the Doist todoist-cli (`td`).

Expands plural nouns ("tasks" -> "task"), two-letter noun+verb codes
("ta" -> "task add", "pl" -> "project list"), and short flags
(-d -> --due, -p -> --project) before exec'ing the real `td` binary.
Also fuzzy-resolves --project/-p values against your real project names,
since `td` itself only does exact/id matching.
"""

import difflib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

NOUN_ALIASES = {
    "tasks": "task",
    "projects": "project",
}

# noun -> {single-letter verb code: real subcommand}
VERBS = {
    "task": {
        "a": "add", "l": "list", "v": "view", "u": "update",
        "d": "delete", "c": "complete", "m": "move", "r": "reschedule",
        "b": "browse",
    },
    "project": {
        "l": "list", "v": "view", "c": "create", "d": "delete",
        "u": "update", "a": "archive", "m": "move",
    },
}

FLAG_ALIASES = {
    "-d": "--due",
    "-p": "--project",
}

CACHE_PATH = Path.home() / ".cache" / "td-wrapper" / "projects.json"
CACHE_TTL = 1800  # seconds


def expand_code(args):
    """Expand a leading plural noun or two-letter noun+verb code, if present."""
    if not args:
        return args

    head = args[0].lower()

    if head in NOUN_ALIASES:
        return [NOUN_ALIASES[head]] + args[1:]

    if len(head) == 2:
        noun = {"t": "task", "p": "project"}.get(head[0])
        if noun:
            verb = VERBS[noun].get(head[1])
            if verb:
                return [noun, verb] + args[1:]

    return args


def expand_flags(args):
    return [FLAG_ALIASES.get(a, a) for a in args]


def load_project_cache():
    try:
        age = time.time() - CACHE_PATH.stat().st_mtime
        if age < CACHE_TTL:
            return json.loads(CACHE_PATH.read_text())
    except OSError:
        pass

    try:
        out = subprocess.run(
            ["td", "project", "list", "--json"],
            capture_output=True, text=True, timeout=10,
        )
        data = json.loads(out.stdout)
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return None

    projects = data if isinstance(data, list) else data.get("projects", data.get("results", []))
    names = [p["name"] for p in projects if isinstance(p, dict) and "name" in p]

    try:
        CACHE_PATH.parent.mkdir(parents=True, exist_ok=True)
        CACHE_PATH.write_text(json.dumps(names))
    except OSError:
        pass
    return names


def resolve_projects(args):
    """Fuzzy-resolve --project values against real project names."""
    names = None
    out = list(args)
    for i, a in enumerate(out):
        if a == "--project" and i + 1 < len(out):
            value = out[i + 1]
            if value.startswith("id:") or value.lower() == "none":
                continue
            if names is None:
                names = load_project_cache()
            if not names or value in names:
                continue
            match = difflib.get_close_matches(value, names, n=1, cutoff=0.4)
            if match:
                out[i + 1] = match[0]
    return out


def main():
    args = sys.argv[1:]
    args = expand_code(args)
    args = expand_flags(args)
    args = resolve_projects(args)
    os.execvp("td", ["td"] + args)


if __name__ == "__main__":
    main()
